        {
          "id": "buildlowIntro",
          "type": "label",
          "text": "PHYSICAL HARDWARE / COMPONENTS   •   R1 = 1 kΩ  •   C1 = 100 nF (non-polarized)  •   W1 remains OFF while you build.",
          "x": 22,
          "y": 72,
          "width": 1416,
          "height": 57,
          "value": 0,
          "min": 0,
