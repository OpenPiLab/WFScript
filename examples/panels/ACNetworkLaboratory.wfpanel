        {
          "id": "lowSchematic",
          "type": "image",
          "text": "LOW-PASS labeled schematic and breadboard map",
          "x": 25,
          "y": 142,
          "width": 1410,
          "height": 545,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "imageName": "rc_lowpass_breadboard.png",
            "imageData": ""
          }
        },
        {
          "id": "lowRows",
          "type": "instruction_card",
          "text": "1  Place the components",
          "x": 25,
          "y": 697,
          "width": 450,
          "height": 208,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "body": "SERIES RESISTOR: connect holes C7 → C13.\nSHUNT CAPACITOR: connect holes D13 → D20.\nAll A–E holes connect horizontally in the same numbered row; rows 7, 13, 20 are separate.\nUse the exact arrangement from the diagram.",
            "tone": "Procedure"
          }
        },
        {
          "id": "lowLeads",
          "type": "instruction_card",
          "text": "2  Connect the AD3 flywires",
          "x": 494,
          "y": 697,
          "width": 450,
          "height": 208,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "body": "W1 → A7 (VIN), CH1+ → B7.\nCH2+ → B13 (VOUT).\nW1 GND → A20; CH1− → B20; CH2− → C20.\nUse ONLY AD3 W1 and Scope pins; do not connect V+, V− or an external supply.",
            "tone": "Procedure"
          }
        },
        {
          "id": "lowCheck",
          "type": "instruction_card",
          "text": "3  Verify BEFORE enabling W1",
          "x": 965,
          "y": 697,
          "width": 470,
          "height": 208,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "body": "With W1 OFF, check there are no shorts between VIN and GND and that row 20 is the shared ground node. Confirm the component VALUES and output location. Then select the matching topology on the Simulation tab, go to MEASURE, toggle WIRING VERIFIED, and explicitly ARM W1.",
            "tone": "Warning"
          }
        },
        {
          "id": "lowBuildFooter",
          "type": "label",
          "text": "STOP W1 before swapping parts or changing topology. An AD3 BNC adapter changes wiring conventions—these instructions use the flywire connector.",
          "x": 25,
          "y": 922,
          "width": 1410,
          "height": 53,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "textFormat": "Plain Text",
            "wordWrap": true,
            "borderVisible": true,
            "cornerRadius": 10
          }
        }
      ]
    },
