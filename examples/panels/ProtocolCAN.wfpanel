        {
          "id": "canFoot",
          "type": "label",
          "text": "Simulation results are labeled as simulation. This is a native SDK controller example, not a passive waveform decoder.\\nStop/Close releases protocol outputs. Configure buttons may physically drive selected DIO pins.",
          "x": 24,
          "y": 727,
          "width": 1112,
          "height": 55,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
