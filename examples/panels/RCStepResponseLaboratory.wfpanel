          "width": 709,
          "height": 185,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "body": "Physical R≥900 Ω, 70 µs≤RC≤1200 µs, frequency 60–150 Hz, and each half period must be ≥6τ. Need complete RISE and FALL half-cycles. Failure or abort requests both Scope and W1 stops. No fake readings are substituted.",
            "tone": "Warning"
          }
        },
