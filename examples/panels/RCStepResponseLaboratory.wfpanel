          "id": "wiringOne",
          "type": "instruction_card",
          "text": "BREADBOARD  /  ONE SHARED GROUND",
          "x": 22,
          "y": 657,
          "width": 452,
          "height": 211,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "body": "W1 → one end of R. The far end is VCAP. Put capacitor from VCAP to ground. CH1+ senses W1 side of R. CH2+ senses VCAP. Tie W1 GND, 1− and 2− to common ground.",
            "tone": "Procedure"
          }
        },
        {
          "id": "wiringTwo",
          "type": "instruction_card",
          "text": "COMPONENT AND VOLTAGE LIMITS",
          "x": 503,
          "y": 657,
          "width": 451,
          "height": 211,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "body": "Use a non-polarized capacitor. For the supplied circuit: R=980 Ω, C≈571 nF. W1 square is ±0.5 V (1 Vpp), zero DC offset. No supply rails or external energized circuits.",
            "tone": "Warning"
          }
        },
        {
          "id": "wiringThree",
          "type": "instruction_card",
          "text": "BEFORE A PHYSICAL CAPTURE",
          "x": 982,
          "y": 657,
          "width": 456,
          "height": 211,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "body": "Turn W1 OFF when moving leads. Verify instrument ground and input nodes. Select Physical Device, check R,C and half-period ≥6τ, enable WIRING VERIFIED, then click CAPTURE. The software cannot detect miswiring.",
            "tone": "Warning"
          }
        },
