          "y": 14,
          "width": 1380,
          "height": 50,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "borderVisible": true,
            "cornerRadius": 10,
            "textFormat": "Plain Text",
            "wordWrap": false
          }
        },
        {
          "id": "studioIntro",
          "type": "label",
          "text": "One portable Panel. Three imported open-source libraries + reusable DSP modules. Generate a signal, inspect its FFT, apply a Butterworth filter and losslessly pack the sample set.",
