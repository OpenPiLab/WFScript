{
  "format": "WFScriptPanel",
  "version": 2,
  "description": "WFScript v0.2-dev.8.6 — JavaScript DSP Studio: portable FFT/filter/FFT plotting; third-party Fraction.js, pako and base64-js; simulation only and no hardware outputs.",
  "scriptName": "JavaScriptDSPStudio.js",
  "activePageId": "studio",
  "lifecycle": {
    "initializeEnabled": false,
    "shutdownEnabled": false
  },
  "appearance": {
    "themeMode": "dark",
    "background": "",
    "showDesignGrid": false
  },
  "pages": [
    {
      "id": "studio",
      "name": "DSP Studio",
      "width": 1425,
      "height": 1000,
      "controls": [
        {
          "id": "studioTitle",
          "type": "label",
          "text": "JAVASCRIPT DSP STUDIO   /   SIGNAL ANALYSIS WORKBENCH",
