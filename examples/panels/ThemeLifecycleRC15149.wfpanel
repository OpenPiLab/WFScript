  "script": "// RC1.5.14.9 theme test \u2014 simulated only. No instruments or TestRunner.\nvar batches=0;\nfunction fillTables() {\n    var measurement=[]; var experiment=[]; var now=Date.now();\n    for(var i=0;i<200;++i) {\n        var n=batches*200+i;\n        measurement.push({name:'Vout '+n,value:3.3+0.01*Math.sin(n*.02),low:3.0,high:3.6,unit:'V'});\n        experiment.push([n,now,'ADC0',(3.3+0.01*Math.sin(n*.02)).toFixed(4),10]);\n    }\n    ui.set('measurementTable',{append:measurement});\n    ui.set('experimentTable',{appendRows:experiment});\n    ui.set('diagnostics',{append:{level:'INFO',source:'ThemeLab',message:'Added batch '+batches+' at '+now}});\n    batches++;\n    verifyCounts();\n}\nfunction clearTables() {\n    ui.set('measurementTable',{reset:true});\n    ui.set('experimentTable',{clear:true});\n    ui.set('diagnostics',{append:{level:'WARN',source:'ThemeLab',message:'Cleared both result tables'}});\n    batches=0; verifyCounts();\n}\nfunction verifyCounts() {\n    var n=ui.tableRowCount('experimentTable');\n    ui.set('status','Batches '+batches+' / Experiment rows '+n+' \u2014 Change View > Dark Theme and verify rows stay visible.');\n    print('ThemeLab: batches='+batches+' experimentRows='+n);\n}\nprint('Theme lifecycle lab ready. First fill tables, then switch the View theme.');\n",
  "libraries": []
}
