        {
          "id": "pgFooter",
          "type": "label",
          "text": "HARDWARE TEST: DIO0 — 1 kΩ — DIO1; all other DIOs disconnected. TEST checks transitions, actual frequency, duty and pin agreement.\nNo high-speed timing guarantee from Windows or simulation; actual edges come from the AD3 DigitalOut engine.",
          "x": 24,
          "y": 731,
          "width": 1110,
          "height": 51,
          "value": 0,
