          "type": "instruction_card",
          "text": "Reuse this pattern",
          "x": 36,
          "y": 1031,
          "width": 1178,
          "height": 120,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "tone": "Information",
            "body": "Replace the editable source table with test setpoints, calibration limits, expected performance curves, or recorded measurements. The same JavaScript pattern — read, validate, transform, plot, summarize — works without a specialized widget. A native Test Executive run is separate and can archive certified results."
          }
        }
      ]
    }
  ]
}
