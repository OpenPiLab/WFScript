{
  "format": "WFScriptPanel",
  "version": 2,
  "description": "Educational Visual Widgets showcase. Entire RC schematic image is stored inside this .wfpanel as Base64. No external picture file required.",
  "scriptName": "EducationalVisuals.js",
  "script": "// Visual-only, hardware-safe educational widget showcase.\n// Select Stop/Design and edit Image/Diagram or Instruction Card properties.\nprint(\"Educational Visual Widgets: embedded circuit image and instruction cards loaded.\");\n",
  "activePageId": "theory",
  "appearance": {
    "themeMode": "dark",
    "background": "",
    "showDesignGrid": true
  },
  "pages": [
    {
      "id": "theory",
      "name": "00 Circuit Guide",
      "width": 1270,
      "height": 850,
      "controls": [
        {
          "id": "header",
          "type": "label",
          "text": "RC Filter Lab — Educational Visual Widgets",
          "x": 28,
          "y": 17,
          "width": 1145,
          "height": 53,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "textFormat": "Plain Text",
            "wordWrap": false,
            "borderVisible": false
          }
        },
        {
          "id": "circuitImage",
          "type": "image",
          "text": "RC low-pass filter wiring (W1, CH1, CH2)",
          "x": 28,
          "y": 85,
          "width": 900,
          "height": 397,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "imageName": "RC_Filter_Diagram.png",
            "imageData": "",
            "scaleMode": "Fit",
            "captionVisible": true,
            "borderVisible": true
          }
        },
        {
          "id": "setupCard",
          "type": "instruction_card",
          "text": "Build the circuit",
          "x": 948,
          "y": 85,
          "width": 290,
          "height": 220,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "tone": "Procedure",
            "body": "1. W1 to 10 kΩ resistor.\n2. Place 10 nF capacitor from Vout to GND.\n3. CH1+ to Vin; CH2+ to Vout.\n4. Connect both scope negatives to GND."
          }
        },
        {
          "id": "safetyCard",
          "type": "instruction_card",
          "text": "Before enabling power",
          "x": 948,
          "y": 321,
          "width": 290,
          "height": 161,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "tone": "Warning",
            "body": "Check wiring and instrument limits. Begin with a low-amplitude waveform. This panel is an educational illustration; it does not run instruments."
          }
        },
        {
          "id": "theoryCard",
          "type": "instruction_card",
          "text": "Predict the response",
          "x": 28,
          "y": 508,
          "width": 595,
          "height": 156,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "tone": "Information",
            "body": "Time constant τ = RC = 100 µs. Cutoff fc = 1/(2πRC) ≈ 1592 Hz. At fc, gain is about 0.707 (−3 dB)."
          }
        },
        {
          "id": "noteCard",
          "type": "instruction_card",
          "text": "Try extending this lab",
          "x": 641,
          "y": 508,
          "width": 597,
          "height": 156,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "tone": "Success",
            "body": "Add a sine-wave sweep, measure CH1 and CH2 amplitudes, compare theory with results, and archive the experimental observations."
          }
        }
      ]
    },
    {
      "id": "notes",
      "name": "01 Your Lab Notes",
      "width": 1270,
      "height": 850,
      "controls": [
        {
          "id": "notesTitle",
          "type": "label",
          "text": "Editable Lab Instructions — select a card and edit its properties",
          "x": 28,
          "y": 25,
          "width": 1110,
          "height": 57,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "textFormat": "Plain Text",
            "borderVisible": false
          }
        },
        {
          "id": "procedureCard",
          "type": "instruction_card",
          "text": "Procedure",
          "x": 30,
          "y": 108,
          "width": 580,
          "height": 218,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "tone": "Procedure",
            "body": "1. Predict output amplitude at 500 Hz and 5 kHz.\n2. Set the generator to a safe amplitude.\n3. Measure CH1 and CH2.\n4. Calculate gain and compare with the RC model."
          }
        },
        {
          "id": "tipCard",
          "type": "instruction_card",
          "text": "Teaching tip",
          "x": 638,
          "y": 108,
          "width": 580,
          "height": 218,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "tone": "Information",
            "body": "A square wave contains many harmonics. Smoothing its edges illustrates a different view of the same circuit than a sinusoidal frequency sweep."
          }
        },
        {
          "id": "warningCard",
          "type": "instruction_card",
          "text": "Important",
          "x": 30,
          "y": 360,
          "width": 580,
          "height": 168,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "tone": "Warning",
            "body": "A measured waveform is not necessarily a pass/fail outcome. Record component tolerances, input loading and sample-rate assumptions."
          }
        },
        {
          "id": "successCard",
          "type": "instruction_card",
          "text": "After measuring",
          "x": 638,
          "y": 360,
          "width": 580,
          "height": 168,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "tone": "Success",
            "body": "Describe what changed as frequency increased and explain why the capacitor produced the observed response."
          }
        }
      ]
    }
  ],
  "libraries": []
}
