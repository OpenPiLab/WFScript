          "text": "Press READ PENDING to see the currently entered UUT fields and the frozen previous run ID.",
          "x": 755,
          "y": 293,
          "width": 505,
          "height": 255,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "textFormat": "Plain Text",
            "wordWrap": true,
            "borderVisible": true,
            "cornerRadius": 8
          }
        },
        {
          "id": "mirrorFooter",
          "type": "label",
          "text": "Changing either form updates the same pending C++ data; no active widget and no duplicated configuration.",
          "x": 25,
          "y": 754,
          "width": 1235,
          "height": 57,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "textFormat": "Plain Text",
            "wordWrap": true,
            "borderVisible": true,
            "cornerRadius": 8
          }
        }
      ]
    }
  ],
  "script": "/**\n * OPERATOR PANEL — four jobs only: Run, Next, Stop/Reset, Display.\n *\n * The C++ runtime has ALREADY loaded the saved project test definition\n * and resolved TestSteps.mjs BEFORE this script is evaluated.\n *\n * To edit timing, limits, step order or handlers: Panel Designer > Test Sequence.\n * To change what a measurement does: edit TestSteps.mjs.\n * There is no TestRunner.loadDefinition(), add() or configure() here.\n */\n\nfunction operatorAction(action) {\n    if (!action()) {\n        const message='Executive: '+TestRunner.lastError;\n        print(message);\n        ui.set('uutFooter',message);\n    } else {\n        ui.set('uutFooter','Test action accepted — inspect the Test Station and Run Report pages.');\n    }\n}\n\n// Button IDs correspond directly to buttons on Page 01.\nui.on('stationPass', 'clicked', function() { operatorAction(function() { return TestRunner.run(); }); });\n// Native Run Information widget supplies the fields to C++ automatically.\n// This button runs the very same project-owned sequence, with no metadata script.\nui.on('uutRun', 'clicked', function() { operatorAction(function() { return TestRunner.run(); }); });\nui.on('uutReset','clicked', function() { operatorAction(function() { return TestRunner.reset(); }); refreshReport(); });\nui.on('stationNext', 'clicked', function() { operatorAction(function() { return TestRunner.next(); }); });\nui.on('stationFail', 'clicked', function() { operatorAction(function() { return TestRunner.terminate(); }); });\nui.on('stationReset', 'clicked', function() { operatorAction(function() { return TestRunner.reset(); }); refreshReport(); });\n\nfunction escapeText(value) {\n    return String(value === undefined || value === null ? '' : value)\n        .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n}\n\nfunction refreshReport() {\n    const r = TestRunner.report();\n    const s = TestRunner.summary();\n    const steps = r.steps || [];\n    const measurements = r.measurements || [];\n    const runInfo = r.runInfo || {};\n    const archive = r.executionId ? TestRunner.archiveInfo() : {status:'idle'};\n    const archiveText = archive.status === 'saved'\n        ? 'AUTO-ARCHIVED JSON: ' + archive.path\n        : archive.status === 'error'\n            ? 'ARCHIVE FAILED: ' + archive.error\n            : archive.status === 'disabled'\n                ? 'Automatic archiving is disabled in Test Sequence > Report Storage.'\n                : 'Archive status: ' + archive.status;\n    if (r.executionId) ui.set('reportFooter', archiveText);\n    const metadata = Object.keys(runInfo).map(function(key) {\n        return '<tr><td>' + escapeText(key) + '</td><td>' + escapeText(runInfo[key]) + '</td></tr>';\n    }).join('');\n    const rows = steps.map(function(step) {\n        return '<tr><td>' + escapeText(step.name) + '</td><td>' +\n            escapeText(step.status) + '</td><td>' + escapeText(step.elapsedMs) + ' ms</td></tr>';\n    }).join('');\n    const data = measurements.map(function(m) {\n        return '<tr><td>' + escapeText(m.name) + '</td><td>' +\n            escapeText(m.value) + ' ' + escapeText(m.unit) + '</td><td>' +\n            escapeText(m.low) + ' – ' + escapeText(m.high) + '</td><td>' +\n            escapeText(m.status) + '</td></tr>';\n    }).join('');\n    ui.set('stationReport', '<div style=\"font-family:Segoe UI;color:#d9e8f4;font-size:12px\">' +\n        '<h2>Native Test Report</h2><p><b>Status:</b> ' + escapeText(s.state) +\n        ' &nbsp; <b>Configured deadline:</b> ' + escapeText(s.totalTimeoutMs) + ' ms' +\n        ' &nbsp; <b>Elapsed:</b> ' + escapeText(s.elapsedMs) + ' ms</p>' +\n        '<p><b>Execution ID:</b> ' + escapeText(r.executionId || 'Not yet started') + '</p>' +\n        '<p><b>Archive:</b> ' + escapeText(archiveText) + '</p>' +\n        '<h3>Run Information</h3><table width=\"100%\" cellpadding=\"4\"><tr><th align=\"left\">Field</th><th align=\"left\">Value</th></tr>' + metadata + '</table>' +\n        '<h3>Steps</h3><table width=\"100%\" cellpadding=\"4\"><tr><th align=\"left\">Step</th><th>Status</th><th>Elapsed</th></tr>' + rows + '</table>' +\n        '<h3>Measurements</h3><table width=\"100%\" cellpadding=\"4\"><tr><th align=\"left\">Measurement</th><th>Actual</th><th>Limits</th><th>Verdict</th></tr>' + data + '</table></div>');\n}\n\nfunction saveReport(format) {\n    const file = TestRunner.exportReport(format);\n    const message = file ? 'Saved ' + format.toUpperCase() + ': ' + file : 'Cannot export: ' + TestRunner.lastError;\n    ui.set('reportFooter', escapeText(message));\n    print(message);\n}\nui.on('reportRefresh','clicked', refreshReport);\nui.on('reportExportJson','clicked',function() { saveReport('json'); });\nui.on('reportExportCsv','clicked',function() { saveReport('csv'); });\n\n\n// Page 06 demonstrates the project-owned pending model and two synchronized\n// form widgets. This is READ-ONLY JavaScript; it never configures or copies\n// UUT data. The C++ model owns both forms and the TestRunner start snapshot.\nui.on('mirrorRead','clicked',function() {\n    const pending=TestRunner.pendingRunInfo();\n    const mainView=ui.get('uutFields');\n    const mirrorView=ui.get('uutFieldsMirror');\n    const completed=TestRunner.runInfo();\n    const message='Pending UUT: '+JSON.stringify(pending)+\n        '\\nPage 01 view: '+JSON.stringify(mainView)+\n        '\\nPage 06 view: '+JSON.stringify(mirrorView)+\n        '\\nFrozen executed UUT: '+JSON.stringify(completed);\n    print(message);\n    ui.set('mirrorStatus',message);\n});\n\nTestRunner.onFinished(function() { refreshReport(); });\nrefreshReport(); // Reading state is safe; no test runs at Panel startup.\n",
  "libraries": [
    {
      "name": "TestSteps.mjs",
      "source": "/**\n * TestSteps.mjs — the ONLY test implementation file.\n *\n * Each exported function does ONE thing and returns the measurement or result.\n * The editor owns order, timing, acceptance limits and cleanup policy.\n * Qt/C++ owns scheduling, comparisons, statuses, and the test report.\n * You can edit these functions without changing the operator Panel.\n */\n\nexport function verifyPositive() {\n    return 3.301;        // In hardware: read the actual supply voltage.\n}\n\nexport function verifyNegative() {\n    return -3.298;\n}\n\nexport function beginClock() {\n    print('Clock acquisition started');\n}\n\nexport function pollClock(stepElapsedMs) {\n    if (stepElapsedMs < 180) return undefined; // Still measuring.\n    return 999.8;      // Numeric result: C++ checks saved limits.\n}\n\nexport function endClock(status, elapsedMs) {\n    print('Clock verification:', status, elapsedMs + ' ms');\n}\n\nexport function verifyPwm() {\n    return 50.1;       // Change to 47.5 to demonstrate a real FAIL.\n}\n\nexport function finalize() {\n    print('All Main tests finished');\n    return true;\n}\n\nexport function restoreStation() {\n    print('Cleanup: restore instruments and release fixture');\n    return true;\n}\n"
    }
  ],
  "testDefinition": {
    "schemaVersion": 1,
    "id": "controller-functional-demo",
    "title": "Controller Functional Test",
    "config": {
      "sequenceId": "stationSequence",
      "tableId": "stationTable",
      "logId": "stationLog",
      "summaryId": "stationSummary",
      "stopOnFailure": true,
      "totalTimeoutMs": 15000
    },
    "steps": [
      {
        "id": "initialize",
        "name": "SETUP — Initialize test station",
        "group": "setup",
        "type": "action",
        "description": "Qt nonblocking 150 ms settling delay",
        "mode": "delay",
        "durationMs": 150,
        "timeoutMs": 600
      },
      {
        "id": "positive",
        "name": "Verify V+ supply",
        "group": "main",
        "type": "numeric",
        "description": "C++ checks returned voltage against 3.25 to 3.35 V",
        "mode": "once",
        "handler": "verifyPositive",
        "limits": {
          "low": 3.25,
          "high": 3.35
        },
        "unit": "V",
        "resultWidget": "resultPositive"
      },
      {
        "id": "negative",
        "name": "Verify V− supply",
        "group": "main",
        "type": "numeric",
        "description": "C++ checks returned voltage against -3.35 to -3.25 V",
        "mode": "once",
        "handler": "verifyNegative",
        "limits": {
          "low": -3.35,
          "high": -3.25
        },
        "unit": "V",
        "resultWidget": "resultNegative"
      },
      {
        "id": "clock",
        "name": "Verify clock frequency",
        "group": "main",
        "type": "numeric",
        "description": "C++ polls every 10 ms; library returns frequency after settling",
        "mode": "poll",
        "intervalMs": 10,
        "timeoutMs": 800,
        "handlers": {
          "start": "beginClock",
          "poll": "pollClock",
          "finish": "endClock"
        },
        "limits": {
          "low": 990,
          "high": 1010
        },
        "unit": "Hz",
        "resultWidget": "resultClock"
      },
      {
        "id": "pwm",
        "name": "Verify PWM duty cycle",
        "group": "main",
        "type": "numeric",
        "description": "C++ checks returned PWM duty against 49 to 51%",
        "mode": "once",
        "handler": "verifyPwm",
        "limits": {
          "low": 49,
          "high": 51
        },
        "unit": "%",
        "resultWidget": "resultPwm"
      },
      {
        "id": "report",
        "name": "Finalize test summary",
        "group": "main",
        "type": "action",
        "description": "Simple action: completes after measurements",
        "mode": "once",
        "handler": "finalize"
      },
      {
        "id": "cleanup",
        "name": "CLEANUP — Restore safe station state",
        "group": "cleanup",
        "type": "action",
        "description": "Runs on failure/timeout/terminate; abort skips it",
        "mode": "once",
        "timeoutMs": 500,
        "handler": "restoreStation"
      }
    ]
  },
  "testLibrary": "TestSteps.mjs",
  "runInformation": {
    "fields": [
      {
        "id": "uutId",
        "label": "UUT Serial Number",
        "type": "text",
        "required": true,
        "default": ""
      },
      {
        "id": "partNumber",
        "label": "Part Number",
        "type": "text",
        "required": true,
        "default": "PCB-1042"
      },
      {
        "id": "hardwareRevision",
        "label": "Hardware Revision",
        "type": "choice",
        "required": false,
        "options": [
          "Rev A",
          "Rev B",
          "Rev C"
        ],
        "default": "Rev C"
      },
      {
        "id": "operatorId",
        "label": "Operator ID",
        "type": "text",
        "required": true,
        "default": "Operator 01"
      },
      {
        "id": "batchNumber",
        "label": "Batch / Lot",
        "type": "text",
        "required": false,
        "default": ""
      },
      {
        "id": "nominalVoltage",
        "label": "Nominal supply (V)",
        "type": "number",
        "required": false,
        "default": 3.3
      },
      {
        "id": "inspectionComplete",
        "label": "Visual inspection complete",
        "type": "boolean",
        "required": false,
        "default": false
      }
    ]
  },
  "reportStorage": {
    "autoSave": true,
    "directory": ""
  }
}
