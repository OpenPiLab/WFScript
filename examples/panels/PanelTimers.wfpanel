        {
          "id": "guideIntro",
          "type": "label",
          "text": "setInterval(callback, ms, ...args) starts a repeating task. setTimeout(callback, ms, ...args) schedules once. clearInterval(id) / clearTimeout(id) cancel. Delays: 10ms–24h; maximum 256 active timers.",
          "x": 24,
          "y": 83,
          "width": 1100,
          "height": 115,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
