        },
        {
          "id": "sigPlot",
          "type": "plot",
          "text": "W1 software preview / captured CH1 waveform",
          "x": 324,
          "y": 466,
          "width": 810,
          "height": 252,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "chartType": "Line",
            "xLabel": "Time (s)",
            "yLabel": "Voltage (V)",
            "showGrid": true,
            "showLegend": true,
            "xAuto": true,
            "yAuto": true,
