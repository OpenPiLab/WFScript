{
  "format": "WFScriptPanel",
  "version": 2,
  "description": "WFScript v5.6.51 example — Control W1, preview waveforms, and capture Scope CH1.",
  "scriptName": "SignalLab.js",
  "activePageId": "signal_lab",
  "lifecycle": {
    "initializeEnabled": false,
    "shutdownEnabled": false
