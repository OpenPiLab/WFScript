        {
          "id": "sigPreview",
          "type": "button",
          "text": "RENDER PREVIEW",
          "x": 847,
          "y": 397,
          "width": 287,
          "height": 50,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {
