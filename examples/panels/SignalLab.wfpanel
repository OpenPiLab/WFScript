          }
        },
        {
          "id": "sigRms",
          "type": "digital_display",
          "text": "CH1 RMS",
          "x": 24,
          "y": 574,
          "width": 280,
          "height": 142,
          "value": 0,
          "min": 0,
          "max": 10,
          "events": {},
          "properties": {
            "unit": "V RMS",
            "accent": "cyan",
            "decimals": 3
          }
        },
        {
          "id": "sigPlot",
          "type": "plot",
          "text": "W1 software preview / captured CH1 waveform",
          "x": 324,
          "y": 466,
          "width": 810,
          "height": 252,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "chartType": "Line",
            "xLabel": "Time (s)",
            "yLabel": "Voltage (V)",
            "showGrid": true,
            "showLegend": true,
            "xAuto": true,
            "yAuto": true,
            "showCursors": true,
            "cursorA": 0.0,
            "cursorB": 0.001,
            "lineWidth": 2.0
          }
        },
        {
          "id": "sigStatus",
          "type": "label",
          "text": "PREVIEW ONLY — Start W1 to enable the selected output; then changes apply live.",
          "x": 24,
          "y": 730,
          "width": 1110,
          "height": 45,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "borderVisible": true,
            "cornerRadius": 10
          }
        }
