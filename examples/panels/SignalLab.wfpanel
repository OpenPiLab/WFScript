        {
          "id": "sigIntro",
          "type": "label",
          "text": "Configure W1 and Scope CH1 using Panel controls. Preview is software-only.\nAfter Start W1, waveform and setpoint edits apply live. Stop W1 disables output.",
          "x": 24,
          "y": 65,
          "width": 1111,
          "height": 43,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
