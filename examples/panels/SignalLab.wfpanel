            "lineWidth": 2.0
          }
        },
        {
          "id": "sigStatus",
          "type": "label",
          "text": "PREVIEW ONLY — Start W1 to enable the selected output; then changes apply live.",
          "x": 24,
          "y": 730,
          "width": 1110,
          "height": 45,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "borderVisible": true,
            "cornerRadius": 10
          }
        }
