          "events": {},
          "properties": {
            "options": "250 kS/s|1 MS/s|2 MS/s",
            "defaultIndex": 1,
            "accent": "blue"
          }
        },
        {
          "id": "sigSamples",
          "type": "option_selector",
          "text": "SCOPE SAMPLES",
