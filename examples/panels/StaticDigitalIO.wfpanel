            "borderVisible": true,
            "cornerRadius": 11
          }
        },
        {
          "id": "dioHelp",
          "type": "label",
          "text": "DIO outputs are 3.3 V. Z = high impedance. Pins change ONLY when you select Z/LOW/HIGH or run a test. DIO0→1 loopback uses 1 kΩ.",
