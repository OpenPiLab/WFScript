{
  "format": "WFScriptPanel",
  "version": 2,
  "description": "WFScript v5.6.51 example — Set Z, LOW and HIGH per pin, read inputs and test a physical loopback.",
  "scriptName": "StaticDigitalIO.js",
  "activePageId": "static_dio",
  "lifecycle": {
    "initializeEnabled": false,
    "shutdownEnabled": false
  },
  "appearance": {
    "themeMode": "dark",
    "background": "",
