            "okText": "MASTER OFF",
            "warningText": "NO READBACK",
            "alarmText": "OUTPUT ACTIVE"
          }
        },
        {
          "id": "psNote",
          "type": "label",
          "text": "SAFE-START: Both rails and master start OFF. POWER ON is required; setpoint edits apply when active.\nMeasured V+/V− refresh 4 times/sec while ON and briefly after POWER OFF. Stop Panel also disables master.",
          "x": 24,
          "y": 677,
          "width": 1110,
          "height": 70,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "borderVisible": true,
            "cornerRadius": 11
          }
        },
        {
          "id": "psStatus",
          "type": "label",
          "text": "READY — Both rails disabled. Change setpoints, select rails, then POWER ON.",
          "x": 24,
          "y": 753,
          "width": 1110,
          "height": 32,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "borderVisible": true,
            "cornerRadius": 11
          }
        }
