            "decimals": 3
          }
        },
        {
          "id": "psMinusReadout",
          "type": "digital_display",
          "text": "V− OUTPUT",
          "x": 374,
          "y": 495,
          "width": 328,
          "height": 158,
          "value": 0,
          "min": -5,
          "max": 0,
          "events": {},
