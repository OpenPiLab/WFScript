        {
          "id": "psState",
          "type": "status_banner",
          "text": "SUPPLIES",
          "x": 740,
          "y": 512,
          "width": 394,
          "height": 141,
          "value": 0,
          "min": 0,
          "max": 2,
          "events": {},
