        {
          "id": "psNote",
          "type": "label",
          "text": "SAFE-START: Both rails and master start OFF. Setpoints are staged until POWER ON; editing while active applies settings.\nPOWER OFF or Stop Panel disables the AD3 supply master. Real readback is shown only when available.",
          "x": 24,
          "y": 677,
          "width": 1110,
          "height": 70,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "borderVisible": true,
            "cornerRadius": 11
          }
        },
        {
          "id": "psStatus",
          "type": "label",
          "text": "READY — Both rails disabled. Change setpoints, select rails, then POWER ON.",
          "x": 24,
          "y": 753,
          "width": 1110,
          "height": 32,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "borderVisible": true,
            "cornerRadius": 11
          }
        }
      ]
