        {
          "id": "uutDetails",
          "type": "label",
          "text": "<div style=\"font-family:Segoe UI;color:#d9e8f4;font-size:13px\"><h3 style=\"color:#7dd3fc\">Physical test checklist</h3><p><b>1.</b> W1 connected to 1+; GND connected to 1−.<br><b>2.</b> Select Device → Physical Device before Run Panel.<br><b>3.</b> Confirm W1 will produce ±1 V relative to GND.<br><b>4.</b> Use STOP (CLEANUP) on the Live Test page for graceful termination.<br><b>5.</b> JSON reports are automatically saved to the configured results folder.</p></div>",
          "x": 744,
