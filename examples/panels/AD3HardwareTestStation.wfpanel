  "script": "/**\n * AD3 Hardware Test Station — operator script.\n * No test definition/configuration in this file. Native C++ reads project-owned\n * testDefinition, Run Information, Report Storage and AD3LoopbackSteps.mjs.\n * The MODULE operates the instrument; this script only handles UI/reporting.\n */\nfunction action(label, fn) {\n    const ok = fn();\n    const msg = ok ? label + ' accepted.' : label + ' rejected: ' + TestRunner.lastError;\n    print('[AD3 operator] ' + msg);\n    ui.set('uutFooter', msg);\n}\nui.on('uutRun','clicked', function(){ action('RUN TEST',function(){return TestRunner.run();}); });\nui.on('stationRun','clicked',function(){ action('RUN TEST',function(){return TestRunner.run();}); });\nui.on('stationStop','clicked',function(){ action('STOP (CLEANUP)',function(){return TestRunner.terminate();}); });\nui.on('uutReset','clicked',function(){action('RESET',function(){return TestRunner.reset();}); refreshReport();});\nui.on('stationReset','clicked',function(){action('RESET',function(){return TestRunner.reset();}); refreshReport();});\nui.on('stationReportButton','clicked',refreshReport);\n\nfunction escapeHtml(value) {\n    return String(value === undefined || value === null ? '' : value)\n        .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n}\nfunction refreshReport() {\n    const report=TestRunner.report();\n    const summary=TestRunner.summary();\n    const steps=report.steps || [], measurements=report.measurements || [];\n    const archive=report.executionId ? TestRunner.archiveInfo() : {status:'idle'};\n    const mode=(report.instrument && report.instrument.mode) || 'not started';\n    const archivetext=archive.status==='saved' ? 'SAVED: '+archive.path :\n        archive.status==='error' ? 'ARCHIVE ERROR: '+archive.error :\n        'Archive status: '+archive.status;\n    const uut=Object.keys(report.runInfo || {}).map(function(key){\n        return '<tr><td>'+escapeHtml(key)+'</td><td>'+escapeHtml(report.runInfo[key])+'</td></tr>';\n    }).join('');\n    const stepRows=steps.map(function(s){\n        return '<tr><td>'+escapeHtml(s.name)+'</td><td>'+escapeHtml(s.status)+'</td><td>'+escapeHtml(s.elapsedMs)+' ms</td></tr>';\n    }).join('');\n    const measureRows=measurements.map(function(m){\n        return '<tr><td>'+escapeHtml(m.name)+'</td><td>'+escapeHtml(m.value)+' '+escapeHtml(m.unit)+\n          '</td><td>'+escapeHtml(m.low)+' ... '+escapeHtml(m.high)+'</td><td>'+escapeHtml(m.status)+'</td></tr>';\n    }).join('');\n    const html='<div style=\"font-family:Segoe UI;color:#d9e8f4;font-size:12px\">'+\n      '<h2>AD3 Hardware Loopback — Native Test Report</h2>'+\n      '<p><b>RESULT:</b> '+escapeHtml(summary.state)+' &nbsp; <b>Instrument:</b> '+escapeHtml(mode)+\n      ' &nbsp; <b>Elapsed:</b> '+escapeHtml(summary.elapsedMs)+' ms</p>'+\n      '<p><b>Execution ID:</b> '+escapeHtml(report.executionId || '(not run yet)')+'</p>'+\n      '<p><b>Archive:</b> '+escapeHtml(archivetext)+'</p>'+\n      '<h3>Run Information</h3><table width=\"100%\" cellpadding=\"4\"><tr><th>Field</th><th>Value</th></tr>'+uut+'</table>'+\n      '<h3>Setup / Main / Cleanup</h3><table width=\"100%\" cellpadding=\"4\"><tr><th>Step</th><th>Status</th><th>Time</th></tr>'+stepRows+'</table>'+\n      '<h3>Actual Measurements</h3><table width=\"100%\" cellpadding=\"4\"><tr><th>Measurement</th><th>Value</th><th>Limits</th><th>Result</th></tr>'+measureRows+'</table></div>';\n    ui.set('stationReport',html);\n    if (report.executionId) ui.set('reportFooter',archivetext);\n}\nfunction exportResult(format) {\n    const path=TestRunner.exportReport(format);\n    const text=path ? 'Exported '+format.toUpperCase()+': '+path :\n        'Export failed: '+TestRunner.lastError;\n    ui.set('reportFooter',text); print(text);\n}\nui.on('reportRefresh','clicked',refreshReport);\nui.on('reportExportJson','clicked',function(){exportResult('json');});\nui.on('reportExportCsv','clicked',function(){exportResult('csv');});\nTestRunner.onFinished(function(){ refreshReport(); });\n// No test is started when the Panel starts. Reading the report is harmless.\nrefreshReport();\n",
  "libraries": [
    {
      "name": "AD3LoopbackSteps.mjs",
      "source": "/**\n * AD3LoopbackSteps.mjs — REAL W1 -> Scope CH1 instrument measurements.\n * This library runs inside WFScript's ONE QJSEngine. No module imports are\n * necessary; Wavegen1, Scope1, Device, plots, print are native bindings.\n * The visual Test Sequence owns limit checks and execution order.\n *\n * SAFE WIRING: W1 -> CH1+; AD3 GND -> CH1-. Nothing else connected.\n * Physical operation is explicit: select Physical Device BEFORE Run Panel.\n * The Panel script does not start outputs on load.\n */\nlet capture = null;\n\nfunction requireCaptured(key) {\n    if (capture === null) throw Error('No CH1 capture available; capture step must run first');\n    const v = Number(capture[key]);\n    if (!isFinite(v)) throw Error('Invalid CH1 ' + key + ' measurement');\n    return v;\n}\n\nexport function configureLoopback() {\n    capture = null;\n    if (!Device.isConnected()) throw Error('No AD3 connected or simulator available');\n    // Turn off any previous W1/W2 waveform before configuring.\n    Wavegen1.stop();\n    Wavegen1.Channel1.enable = true;\n    Wavegen1.Channel2.enable = false;\n    Wavegen1.Channel1.Mode.text = 'Simple';\n    Wavegen1.Channel1.Simple.Type.text = 'Sine';\n    Wavegen1.Channel1.Simple.Frequency.value = 1000;\n    Wavegen1.Channel1.Simple.Amplitude.value = 1.0; // V peak, 2 Vpp\n    Wavegen1.Channel1.Simple.Offset.value = 0;\n    Wavegen1.Channel1.Simple.Phase.value = 0;\n    if (Wavegen1.Channel1.Simple.Type.text !== 'Sine')\n        throw Error('Wavegen rejected Sine function');\n    Scope1.Time.Rate.value = 1000000; // 1 MS/s\n    Scope1.Time.Samples.value = 16384;\n    Scope1.Channel1.Range.value = 5;  // supported AD3 hardware 5 Vpp range\n    Scope1.Channel1.Offset.value = 0;\n    Scope1.Channel1.Attenuation.value = 1;\n    Scope1.Trigger.Trigger.text = 'None';\n    if (!Wavegen1.run()) throw Error('W1 start failed: ' + Wavegen1.lastError);\n    const w = Wavegen1.status(1);\n    if (w && w.carrierFunction && w.carrierFunction !== 'Sine') {\n        Wavegen1.stop();\n        throw Error('Unexpected W1 function: ' + w.carrierFunction);\n    }\n    print('[AD3 test] W1 1 kHz sine, 1.0 Vpk, CH1 5 Vpp range; 350 ms settle next');\n    return true;\n}\n\nexport function captureAcRms() {\n    capture = null;\n    if (!Scope1.single()) throw Error('Scope start failed: ' + Scope1.lastError);\n    if (!Scope1.wait(3)) throw Error('Scope acquisition failed: ' + Scope1.lastError);\n    const st = Scope1.Channel1.statistics();\n    if (!st || Number(st.count) < 2048)\n        throw Error('Insufficient CH1 samples: ' + (st ? st.count : 0));\n    const mean = Number(st.mean), rms = Number(st.rms);\n    const frequency = Number(st.frequencyHz);\n    const vpp = Number(st.vpp);\n    if (![mean, rms, frequency, vpp].every(isFinite))\n        throw Error('Non-finite scope statistics (check W1 -> CH1 wiring)');\n    // Ignore DC offset when checking AC RMS, unlike total RMS.\n    const acRms = Math.sqrt(Math.max(0, rms * rms - mean * mean));\n    capture = {acRms:acRms,frequency:frequency,vpp:vpp,mean:mean, count:Number(st.count)};\n    print('[AD3 test] CH1 N=' + capture.count + ', AC RMS=' + acRms.toFixed(4) +\n          ' V, f=' + frequency.toFixed(2) + ' Hz, Vpp=' + vpp.toFixed(4) +\n          ' V, DC=' + mean.toFixed(4) + ' V');\n    // Plot is an optional visualization: an invalid plot must not turn a\n    // valid measurement into a failed test.\n    try { plots.fromScope('hwTrace', 1, 'Last captured CH1'); }\n    catch (e) { print('[AD3 test] Chart not updated: ' + String(e)); }\n    return acRms;\n}\n\nexport function measureFrequency() { return requireCaptured('frequency'); }\nexport function measureVpp()       { return requireCaptured('vpp'); }\nexport function measureMean()      { return requireCaptured('mean'); }\n\nexport function cleanupLoopback() {\n    // Always attempt BOTH shutdown operations. Even a Scope error must not\n    // prevent W1 shutdown. Best effort hardware-off is more important than UI.\n    let scopeError = null;\n    try { Scope1.stop(); } catch (e) { scopeError = String(e); }\n    try { Wavegen1.stop(); }\n    catch (e) { throw Error('W1 could not be stopped: ' + String(e)); }\n    print('[AD3 test] Cleanup: Scope stopped; W1 disabled' +\n          (scopeError ? ' (scope warning: '+scopeError+')' : ''));\n    return true;\n}\n"
    }
  ],
  "testDefinition": {
    "schemaVersion": 1,
    "id": "ad3-w1-ch1-physical-loopback",
    "title": "AD3 W1 to CH1 — Real Hardware Test",
    "config": {
      "sequenceId": "stationSequence",
      "tableId": "stationTable",
      "logId": "stationLog",
      "summaryId": "stationSummary",
      "stopOnFailure": true,
      "totalTimeoutMs": 12000
    },
    "steps": [
      {
        "id": "configure",
        "name": "SETUP — Configure and start W1 / Scope",
        "group": "setup",
        "type": "action",
        "description": "1 kHz Sine, 1 Vpk, 0 V DC; CH1 5 Vpp, 16,384 samples @ 1 MS/s",
        "mode": "once",
        "timeoutMs": 1600,
        "handler": "configureLoopback"
      },
      {
        "id": "settle",
        "name": "SETUP — Allow generator to settle",
        "group": "setup",
        "type": "action",
        "description": "Native nonblocking 350 ms settling delay",
        "mode": "delay",
        "durationMs": 350,
        "timeoutMs": 850
      },
      {
        "id": "acRms",
        "name": "Measure CH1 AC RMS",
        "group": "main",
        "type": "numeric",
        "description": "Acquire once; return AC-coupled RMS from CH1 samples",
        "mode": "once",
        "timeoutMs": 6500,
        "handler": "captureAcRms",
        "limits": {
          "low": 0.6,
          "high": 0.82
        },
        "unit": "V",
        "resultWidget": "resultAcRms"
      },
      {
        "id": "frequency",
        "name": "Measure CH1 frequency",
        "group": "main",
        "type": "numeric",
        "description": "Read frequency from same captured samples",
        "mode": "once",
        "timeoutMs": 700,
        "handler": "measureFrequency",
        "limits": {
          "low": 975,
          "high": 1025
        },
        "unit": "Hz",
        "resultWidget": "resultFrequency"
      },
      {
        "id": "peakToPeak",
        "name": "Measure CH1 peak-to-peak voltage",
        "group": "main",
        "type": "numeric",
        "description": "Read Vpp from same captured samples",
        "mode": "once",
        "timeoutMs": 700,
        "handler": "measureVpp",
        "limits": {
          "low": 1.7,
          "high": 2.3
        },
        "unit": "V",
        "resultWidget": "resultVpp"
      },
      {
        "id": "dcOffset",
        "name": "Measure CH1 DC mean",
        "group": "main",
        "type": "numeric",
        "description": "Read mean DC offset from same captured samples",
        "mode": "once",
        "timeoutMs": 700,
        "handler": "measureMean",
        "limits": {
          "low": -0.1,
          "high": 0.1
        },
        "unit": "V",
        "resultWidget": "resultOffset"
      },
      {
        "id": "cleanup",
        "name": "CLEANUP — Stop Scope and W1",
        "group": "cleanup",
        "type": "action",
        "description": "Safely stop Wavegen and Scope after success, test failure, or graceful terminate",
        "mode": "once",
        "timeoutMs": 1600,
        "handler": "cleanupLoopback"
      }
    ]
  },
  "testLibrary": "AD3LoopbackSteps.mjs",
  "runInformation": {
    "fields": [
      {
        "id": "uutId",
        "label": "UUT / Run Serial Number",
        "type": "text",
        "required": true,
        "default": ""
      },
      {
        "id": "partNumber",
        "label": "Board / Test Fixture",
        "type": "text",
        "required": false,
        "default": "AD3-LOOPBACK"
      },
      {
        "id": "operatorId",
        "label": "Operator",
        "type": "text",
        "required": false,
        "default": "Lab Operator"
      },
      {
        "id": "testNote",
        "label": "Run Notes",
        "type": "text",
        "required": false,
        "default": ""
      }
    ]
  },
  "reportStorage": {
    "autoSave": true,
    "directory": ""
  }
}
