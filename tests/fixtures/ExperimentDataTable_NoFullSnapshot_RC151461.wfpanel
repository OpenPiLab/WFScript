      "properties": {
        "columns": "Seq|Callback Epoch (ms)|Timer|Simulated Voltage (V)|Callback Delta (ms)",
        "initialRows": "",
        "maxRows": 50000,
        "editable": true,
        "tableTitle": "Live Experiment Data",
        "statusText": "Ready for timer streaming or manual editing",
        "showToolbar": true,
