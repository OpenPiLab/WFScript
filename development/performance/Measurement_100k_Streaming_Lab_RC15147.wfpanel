  "description": "RC1.5.14.7 hardware-free Measurement Table 100k streaming and archived Test Results Browser stress lab.",
  "format": "WFScriptPanel",
  "libraries": [],
  "script": "// RC1.5.14.7 live Measurement Table stress lab, hardware-free.\n// The production TestRunner normally owns this table. Here we send the\n// same incremental {append: ...} and {reset: true} updates directly.\n// Browser validation uses the separate archived .json fixture in this package.\nvar active=false, timer=0, sent=0, batches=0, run=0, errors=0;\nvar LIMIT=100000, PER_BATCH=1000;\nfunction log(level,message){\n    ui.set('diagnostics',{append:{level:level,source:'MeasureLab',message:message}});\n}\nfunction update(){\n    ui.set('status',(active?'STREAMING':'STOPPED')+'  |  sent='+sent+'/'+LIMIT+\n        '  |  batches='+batches+'  |  errors='+errors+'  |  TestRunner not required');\n}\nfunction makeBatch(count){\n    var start=sent,rows=[];\n    for(var j=0;j<count;++j){\n        var n=start+j, v=3.3+Math.sin(n/60)*0.018;\n        rows.push({name:'Voltage point '+n, value:Number(v.toFixed(5)),\n                   low:3.2,high:3.4,unit:'V'});\n    }\n    return rows;\n}\nfunction addBatch(count){\n    if(sent>=LIMIT)return false;\n    count=Math.min(count,LIMIT-sent);\n    var rows=makeBatch(count);\n    if(!ui.set('measurementTable',{append:rows})){\n        errors++;log('ERROR','append rejected near '+sent);\n        stopStreaming();return false;\n    }\n    sent+=count;batches++;\n    if(sent%10000<count || sent==LIMIT){\n        log('INFO','PROGRESS run='+run+' total='+sent+'/'+LIMIT+\n            ' callbackEpochMs='+Date.now());\n        update();\n    }\n    return true;\n}\nfunction tick(){\n    if(!active)return;\n    for(var k=0;k<2;++k){\n        if(!addBatch(PER_BATCH)){stopStreaming();return;}\n    }\n    if(sent>=LIMIT){stopStreaming();log('PASS','Reached 100000 measurements; now inspect scrolling and first/last rows.');}\n}\nfunction startStreaming(){\n    if(active)return;\n    if(sent>=LIMIT){log('WARN','Already at capacity; Reset Results before another run.');return;}\n    active=true;run++;\n    log('INFO','RUN '+run+' start at row '+sent);\n    timer=setInterval(tick,35);\n    update();\n}\nfunction stopStreaming(){\n    if(timer){clearInterval(timer);timer=0;}\n    active=false;\n    update();\n    log('PASS','STOP with '+sent+' measurements; errors='+errors+' callbackEpochMs='+Date.now());\n}\nfunction resetResults(){\n    stopStreaming();\n    ui.set('measurementTable',{reset:true});\n    sent=0;batches=0;errors=0;\n    log('INFO','RESET: no full-array replacement; history cleared');\n    update();\n}\nfunction appendManual(){\n    if(sent>=LIMIT){log('WARN','100000-measurement limit reached');return;}\n    addBatch(PER_BATCH);\n    update();\n}\nfunction checkLimit(){\n    var expected=Math.min(LIMIT,sent);\n    // Do not call ui.get() or ui.tableRowCount() on measurement_table: unlike\n    // experiment_table, this widget is normally a display sink for TestRunner.\n    log('INFO','Submitted '+expected+' native measurement rows; verify last row in the table, then test archived fixture.');\n    print('Submitted measurements '+expected+'; use visual row range to verify native display');\n}\nfunction onStartup(){\n    ui.set('measurementTable',{reset:true});\n    log('INFO','Ready to stream 100000 simulated measurements in 1000-row batches');\n    update();\n}\nfunction onShutdown(){stopStreaming();}\n",
  "scriptName": "MeasurementTable_100k_Archive_Lab_RC15147.js",
  "version": 1
}
