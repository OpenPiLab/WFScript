            "maxSteps": 100,
            "showProgress": true,
            "showElapsed": true,
            "showNumbers": true,
            "autoScroll": true,
            "compactMode": true
          }
        },
        {
          "id": "rigolTestTable",
          "type": "measurement_table",
          "text": "Native Test Measurements",
          "x": 626,
          "y": 440,
