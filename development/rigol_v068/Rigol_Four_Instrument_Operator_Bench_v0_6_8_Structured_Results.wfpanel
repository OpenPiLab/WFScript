{
  "format": "WFScriptPanel",
  "version": 2,
  "description": "Four unchanged Rigol operator pages and a fifth native Test Executive page. Real test procedures are in RigolTestSteps.mjs, with shared instrument sessions, safety checks and 62 individually reported steps. RC1.5.9 parameterized native callback test variant; requires RC1.5.9 (not RC1.5.8.1). v0.6.8: eight waveform procedures return 3 native evaluated measurements each.",
  "scriptName": "RigolBench_4Instruments_v0_6_8.js",
  "activePageId": "scope",
  "lifecycle": {
    "initializeEnabled": false,
    "shutdownEnabled": true
  },
  "appearance": {
    "themeMode": "dark",
    "background": "#111823",
    "showDesignGrid": false
  },
