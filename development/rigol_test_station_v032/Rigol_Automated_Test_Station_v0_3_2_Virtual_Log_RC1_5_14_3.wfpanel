        {
          "id": "instructionsTitle",
          "type": "label",
          "text": "FOUR-INSTRUMENT VERIFICATION",
          "x": 840,
          "y": 465,
          "width": 385,
          "height": 42,
          "value": "FOUR-INSTRUMENT VERIFICATION",
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "textFormat": "Rich Text",
            "wordWrap": true,
            "borderVisible": false,
            "cornerRadius": 9
          }
        },
        {
          "id": "instructionsBody",
          "type": "label",
          "text": "<div style=\"font-size:11pt;color:#d7e7f7;text-align:left;line-height:130%;\"><p><b>01</b> &nbsp; Check both independent signal paths.</p><p><b>02</b> &nbsp; Confirm all four instrument identities.</p><p><b>03</b> &nbsp; Acknowledge wiring on Page 02.</p><p><b>04</b> &nbsp; Run the protected 2–5 V DC sweep.</p><p><b>05</b> &nbsp; Verify sine and square at 1/2 Vpp and 1/5 kHz.</p><p><b>06</b> &nbsp; Review waveforms, sweep plots and limits.</p></div>",
          "x": 838,
          "y": 506,
          "width": 391,
          "height": 227,
          "value": "<div style=\"font-size:11pt;color:#d7e7f7;text-align:left;line-height:130%;\"><p><b>01</b> &nbsp; Check both independent signal paths.</p><p><b>02</b> &nbsp; Confirm all four instrument identities.</p><p><b>03</b> &nbsp; Acknowledge wiring on Page 02.</p><p><b>04</b> &nbsp; Run the protected 2–5 V DC sweep.</p><p><b>05</b> &nbsp; Verify sine and square at 1/2 Vpp and 1/5 kHz.</p><p><b>06</b> &nbsp; Review waveforms, sweep plots and limits.</p></div>",
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "textFormat": "Rich Text",
            "wordWrap": true,
            "borderVisible": false,
            "cornerRadius": 9
          }
        },
