{
  "format": "WFScriptPanel",
  "version": 2,
  "description": "Test-only Rigol Station v0.3.2: compatible with native virtual log and long-sweep display in WFScript RC1.5.14.3. Test procedure/SCPI libraries remain unchanged from hardware-validated v0.3.1.",
  "scriptName": "RigolAutomatedTestStation.js",
  "activePageId": "station",
  "lifecycle": {
    "initializeEnabled": true,
    "shutdownEnabled": true
  },
  "appearance": {
    "themeMode": "dark",
    "background": "#101826",
    "showDesignGrid": false
  },
