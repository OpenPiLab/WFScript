            "placeholder": "x.x.x.x",
            "maxLength": 15,
            "required": false,
            "readOnly": false,
            "accent": "green"
          }
        },
        {
          "id": "inputHint",
          "type": "label",
          "text": "IP field accepts four decimal octets (0–255). Invalid input is outlined in red when committed and is never emitted as a valueChanged event.",
