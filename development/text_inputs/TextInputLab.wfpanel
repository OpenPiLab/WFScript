        },
        {
          "id": "dataStatus",
          "type": "label",
          "text": "READY",
          "x": 24,
          "y": 499,
          "width": 994,
          "height": 74,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "textFormat": "Plain Text",
            "wordWrap": true,
