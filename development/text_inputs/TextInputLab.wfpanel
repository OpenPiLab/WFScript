          "text": "READY",
          "x": 24,
          "y": 623,
          "width": 994,
          "height": 64,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "textFormat": "Plain Text",
            "wordWrap": true,
            "borderVisible": false,
            "cornerRadius": 6
          }
        }
      ]
    },
    {
      "id": "data_bindings",
      "name": "02 Linked Inputs",
      "width": 1060,
      "height": 730,
      "controls": [
        {
          "id": "bindHeading",
          "type": "label",
          "text": "PANEL DATA  /  EDITABLE STRING BINDINGS",
          "x": 24,
          "y": 16,
          "width": 1030,
          "height": 52,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "textFormat": "Plain Text",
            "wordWrap": true,
            "borderVisible": false,
            "cornerRadius": 6
          }
        },
        {
          "id": "bindDesc",
          "type": "label",
          "text": "The two aliases share one text variable; the two IPv4 boxes share another. Edits in either field synchronize the other.",
          "x": 24,
          "y": 77,
          "width": 1018,
          "height": 50,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "textFormat": "Plain Text",
            "wordWrap": true,
            "borderVisible": false,
            "cornerRadius": 6
          }
        },
        {
          "id": "dataAlias1",
          "type": "text_input",
          "text": "Alias A",
          "x": 24,
          "y": 159,
          "width": 475,
          "height": 92,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {
            "valueChanged": {
              "handler": "onDataAliasChanged",
              "enabled": true
            }
          },
          "properties": {
            "labelPosition": "Top",
            "defaultText": "Oscilloscope",
            "placeholder": "Enter a value...",
            "maxLength": 256,
            "required": false,
            "readOnly": false,
            "accent": "cyan"
          },
          "bindings": {
            "value": "Bench.Alias"
          }
        },
        {
          "id": "dataAlias2",
          "type": "text_input",
          "text": "Alias B",
          "x": 538,
          "y": 159,
          "width": 475,
          "height": 92,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "labelPosition": "Left",
            "defaultText": "Oscilloscope",
            "placeholder": "Enter a value...",
            "maxLength": 256,
            "required": false,
            "readOnly": false,
            "accent": "cyan"
          },
          "bindings": {
            "value": "Bench.Alias"
          }
        },
        {
          "id": "dataIp1",
          "type": "ip_address_input",
          "text": "Scope IP A",
          "x": 24,
          "y": 278,
          "width": 475,
          "height": 92,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {
            "valueChanged": {
              "handler": "onDataIpChanged",
              "enabled": true
            },
            "validationFailed": {
