          "id": "scopeIp",
          "type": "ip_address_input",
          "text": "MHO954 IP address",
          "x": 24,
          "y": 361,
          "width": 480,
          "height": 92,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {
            "valueChanged": {
              "handler": "onScopeAddressChanged",
