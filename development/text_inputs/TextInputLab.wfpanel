{
  "format": "WFScriptPanel",
  "version": 2,
  "name": "Text and IPv4 Input Widgets — QA",
  "description": "Two native input widgets with label positions, callbacks, validation and Panel Data binding. No instrument activity.",
  "scriptName": "TextInputLab.js",
  "activePageId": "text_inputs",
  "lifecycle": {
    "initializeEnabled": false,
    "shutdownEnabled": false
  },
  "appearance": {
    "themeMode": "dark",
    "background": "#101a27",
    "showDesignGrid": false
  },
  "panelData": [
    {
      "name": "Bench.Alias",
      "type": "text",
      "initial": "Oscilloscope"
    },
    {
      "name": "Bench.ScopeIp",
      "type": "text",
      "initial": "192.168.6.2"
    }
  ],
  "pages": [
    {
      "id": "text_inputs",
      "name": "01 Text and IP",
      "width": 1060,
      "height": 730,
      "controls": [
        {
          "id": "heading",
          "type": "label",
          "text": "TEXT INPUTS  /  NATIVE WIDGET QA",
          "x": 24,
          "y": 16,
          "width": 1030,
          "height": 52,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "textFormat": "Plain Text",
            "wordWrap": true,
            "borderVisible": false,
            "cornerRadius": 6
          }
        },
        {
          "id": "subtitle",
          "type": "label",
          "text": "Four label positions · free text · validated IPv4 · native ui.get()/ui.set() · saved visual event handlers",
          "x": 24,
          "y": 74,
          "width": 1030,
          "height": 44,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "textFormat": "Plain Text",
            "wordWrap": true,
            "borderVisible": false,
            "cornerRadius": 6
          }
        },
        {
          "id": "operatorName",
          "type": "text_input",
          "text": "Operator name",
          "x": 24,
          "y": 137,
          "width": 480,
          "height": 92,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {
            "valueChanged": {
              "handler": "onOperatorNameChanged",
              "enabled": true
            },
            "editingFinished": {
              "handler": "onOperatorNameFinished",
              "enabled": true
            }
          },
          "properties": {
            "labelPosition": "Top",
            "defaultText": "Test Operator",
            "placeholder": "Type an operator name",
            "maxLength": 256,
            "required": false,
            "readOnly": false,
            "accent": "cyan"
          }
        },
        {
          "id": "inputBottom",
          "type": "text_input",
          "text": "Bottom label",
          "x": 538,
          "y": 137,
          "width": 480,
          "height": 92,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "labelPosition": "Bottom",
            "defaultText": "Editable note",
            "placeholder": "Text below control",
            "maxLength": 256,
            "required": false,
            "readOnly": false,
            "accent": "cyan"
          }
        },
        {
          "id": "inputLeft",
          "type": "text_input",
          "text": "Instrument alias",
          "x": 24,
          "y": 247,
          "width": 480,
          "height": 92,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "labelPosition": "Left",
            "defaultText": "MHO954",
            "placeholder": "Friendly name",
            "maxLength": 256,
            "required": false,
            "readOnly": false,
            "accent": "cyan"
