          }
        },
        {
          "id": "instructions",
          "type": "label",
          "text": "One result object can produce multiple PASS/FAIL checks. Open the Test Sequence Editor: edit limits on the Named Results & Limits tab, including channels[0] and temperatures[*].",
          "x": 22,
