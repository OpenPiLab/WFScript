              "enabled": true
            }
          }
        },
        {
          "id": "stationSummary",
          "type": "label",
          "text": "READY — 6 steps, 10 numeric measurements, no instrument needed.",
          "x": 20,
          "y": 830,
          "width": 1260,
          "height": 72,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "textFormat": "Rich Text",
            "wordWrap": true,
            "borderVisible": true,
            "cornerRadius": 9
          }
        },
        {
          "id": "stationSequence",
          "type": "test_sequence",
          "text": "Structured Result Checks",
          "x": 20,
          "y": 245,
          "width": 400,
          "height": 555,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "defaultSteps": "Initialize test station|Verify V+ supply|Verify V− supply|Verify clock frequency|Verify PWM duty cycle|Finalize test summary|Restore station state",
            "maxSteps": 64,
            "showProgress": true,
            "showElapsed": true,
            "showNumbers": true,
