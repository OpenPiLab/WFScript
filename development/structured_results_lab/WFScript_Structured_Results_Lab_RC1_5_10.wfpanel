{
  "format": "WFScriptPanel",
  "version": 2,
  "description": "Hardware-free structured-result lab: named JSON measurements, indexed and array-wide checks, scalar compatibility, and native callback completion.",
  "scriptName": "StructuredResultLab.js",
  "activePageId": "callbackLab",
  "lifecycle": {
    "initializeEnabled": false,
    "shutdownEnabled": false
  },
  "appearance": {
