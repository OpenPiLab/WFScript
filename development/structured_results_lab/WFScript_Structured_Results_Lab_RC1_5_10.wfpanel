            "borderVisible": true,
            "cornerRadius": 9
          }
        },
        {
          "id": "stationPass",
          "type": "button",
          "text": "RUN STRUCTURED TEST",
          "x": 25,
          "y": 160,
          "width": 365,
          "height": 56,
          "value": 0,
          "min": 0,
