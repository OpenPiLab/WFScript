  "script": "// One small operator script. All test logic lives in CallbackTestSteps.mjs.\nfunction onCallbackRun(){if(!TestRunner.run())print('TEST RUN: '+TestRunner.lastError);}\nfunction onCallbackStop(){if(!TestRunner.terminate())print('TEST STOP: '+TestRunner.lastError);}\nfunction onCallbackReset(){if(!TestRunner.reset())print('TEST RESET: '+TestRunner.lastError);}\nTestRunner.onFinished(function(summary){\n    ui.set('stationSummary',String(summary.state).toUpperCase()+' — '+\n        summary.passedMeasurements+' passed measurements / '+summary.totalSteps+' steps');\n    print('Callback Test Lab finished '+JSON.stringify(summary));\n});\n",
  "libraries": [
    {
      "name": "CallbackTestSteps.mjs",
      "source": "// Hardware-free demonstration of the RC1.5.9 native callback contract.\n// The editor defines the step parameters, result limits, timing and sequence.\nexport function setup(step) {\n    // Simulate asynchronous preparation; completing an action with true.\n    setTimeout(function(){\n        if (!TestRunner.isActive(step.token)) return;\n        TestRunner.complete(step.token, true);\n    }, 50);\n}\n\nexport function readVoltage(step) {\n    var voltage=Number(step.params.voltage);\n    setTimeout(function(){\n        // Never issue follow-up commands from an old or canceled callback.\n        if (!TestRunner.isActive(step.token)) return;\n        // Here a real driver would return its measured voltage.\n        TestRunner.complete(step.token, voltage - 0.001);\n    }, 120);\n}\n\nexport function cleanup(step) {\n    // In physical tests: send output OFF and verify the actual OFF readback.\n    setTimeout(function(){\n        if (!TestRunner.isActive(step.token)) return;\n        TestRunner.complete(step.token, true);\n    }, 60);\n}\n"
    }
  ],
  "testDefinition": {
    "schemaVersion": 1,
    "id": "callback-lab-159",
    "title": "Parameterized Callback Test Lab",
    "config": {
      "sequenceId": "stationSequence",
      "tableId": "stationTable",
      "logId": "stationLog",
      "summaryId": "stationSummary",
      "stopOnFailure": true,
      "totalTimeoutMs": 10000
    },
    "steps": [
      {
        "id": "prepare",
        "name": "SETUP — Prepare test station",
        "group": "setup",
        "type": "action",
        "mode": "callback",
        "handler": "setup",
        "timeoutMs": 5000
      },
      {
        "id": "measure_500",
        "name": "Read 5.00 V",
        "group": "main",
        "type": "numeric",
        "mode": "callback",
        "handler": "readVoltage",
        "parameters": {
          "voltage": 5.0
        },
        "limits": {
          "low": 4.95,
          "high": 5.05
        },
        "timeoutMs": 2500,
        "unit": "V"
      },
