{
  "format": "WFScriptPanel",
  "version": 2,
  "description": "IF/THEN/ELSE, declared variables, structured measurements and sweeps; no hardware required",
  "scriptName": "StructuredResultLab.js",
  "activePageId": "callbackLab",
  "lifecycle": {
    "initializeEnabled": false,
    "shutdownEnabled": false
  },
  "appearance": {
    "themeMode": "dark",
    "background": "",
    "showDesignGrid": true
  },
  "pages": [
    {
      "id": "callbackLab",
      "name": "Structured Results",
      "width": 1320,
      "height": 935,
      "controls": [
        {
          "id": "heading",
          "type": "label",
          "text": "SWEEPS & LOOPS LAB — No instruments required",
          "x": 22,
          "y": 20,
          "width": 1260,
          "height": 52,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "textFormat": "Plain Text",
            "wordWrap": true,
            "borderVisible": true,
            "cornerRadius": 9
          }
        },
        {
          "id": "instructions",
          "type": "label",
          "text": "Reusable procedures expand into separately reported steps. Open the Test Sequence Editor: edit limits on the Named Results & Limits tab, including channels[0] and temperatures[*].",
          "x": 22,
          "y": 80,
          "width": 1260,
          "height": 75,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "textFormat": "Plain Text",
            "wordWrap": true,
            "borderVisible": true,
            "cornerRadius": 9
          }
        },
        {
          "id": "stationPass",
          "type": "button",
          "text": "RUN STRUCTURED TEST",
          "x": 25,
          "y": 160,
          "width": 365,
          "height": 56,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {
            "clicked": {
              "handler": "onCallbackRun",
              "enabled": true
            }
          }
        },
        {
          "id": "stationFail",
          "type": "button",
          "text": "STOP + CLEANUP",
          "x": 420,
          "y": 160,
          "width": 365,
          "height": 56,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {
            "clicked": {
              "handler": "onCallbackStop",
              "enabled": true
            }
          }
        },
        {
          "id": "stationReset",
          "type": "button",
          "text": "RESET",
          "x": 815,
          "y": 160,
          "width": 365,
          "height": 56,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {
            "clicked": {
              "handler": "onCallbackReset",
              "enabled": true
            }
          }
        },
        {
          "id": "stationSummary",
          "type": "label",
          "text": "READY — 12 steps, 10 numeric measurements, no instrument needed.",
          "x": 20,
          "y": 830,
          "width": 1260,
          "height": 72,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "textFormat": "Rich Text",
            "wordWrap": true,
            "borderVisible": true,
            "cornerRadius": 9
          }
        },
        {
          "id": "stationSequence",
          "type": "test_sequence",
          "text": "Structured Result Checks",
          "x": 20,
          "y": 245,
          "width": 400,
          "height": 555,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "defaultSteps": "Initialize test station|Verify V+ supply|Verify V− supply|Verify clock frequency|Verify PWM duty cycle|Finalize test summary|Restore station state",
            "maxSteps": 64,
            "showProgress": true,
            "showElapsed": true,
            "showNumbers": true,
            "autoScroll": true,
            "compactMode": false
          }
        },
        {
          "id": "stationTable",
          "type": "measurement_table",
          "text": "Individual Measurement Results",
          "x": 430,
          "y": 245,
          "width": 475,
          "height": 555,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "decimals": 3,
            "maxRows": 100,
            "headers": "Measurement|Actual|Acceptance limits|Result"
          }
        },
        {
          "id": "stationLog",
          "type": "event_log",
          "text": "Test Station Event Log",
          "x": 915,
          "y": 245,
          "width": 365,
          "height": 555,
          "value": 0,
          "min": 0,
          "max": 100,
          "events": {},
          "properties": {
            "maxEntries": 500,
            "autoScroll": true,
            "showTimestamp": true,
            "showSource": true
          }
        }
      ]
    }
  ],
  "script": "// One small operator script. All test logic lives in CallbackTestSteps.mjs.\nfunction onCallbackRun(){if(!TestRunner.run())print('TEST RUN: '+TestRunner.lastError);}\nfunction onCallbackStop(){if(!TestRunner.terminate())print('TEST STOP: '+TestRunner.lastError);}\nfunction onCallbackReset(){if(!TestRunner.reset())print('TEST RESET: '+TestRunner.lastError);}\nTestRunner.onFinished(function(summary){\n    ui.set('stationSummary',String(summary.state).toUpperCase()+' — '+\n        summary.passedMeasurements+' passed measurements / '+summary.totalSteps+' steps');\n    print('Conditional Flow Lab finished '+JSON.stringify(summary));\n});\n",
  "libraries": [
    {
      "name": "ConditionalFlowSteps.mjs",
      "source": "// RC1.5.11: one readable procedure per operation. The native executive\n// expands setpoints/iterations and passes them via step.params.\n// No hardware is required, and asynchronous callbacks carry step.token.\nfunction later(step, produce) {\n    setTimeout(function () {\n        if (!TestRunner.isActive(step.token)) return;\n        try { TestRunner.complete(step.token, produce()); }\n        catch (err) { TestRunner.fail(step.token, String(err)); }\n    }, 55);\n}\nexport function setup(step) {\n    // Variables are defined in Test Variables and reset for every run.\n    // Setup supplies actual readings/decisions. No additional JS global state.\n    if (!TestRunner.setVariable('temperature', 48.5)) throw Error(TestRunner.lastError);\n    if (!TestRunner.setVariable('stationReady', true)) throw Error(TestRunner.lastError);\n    later(step, function () { return true; });\n}\nexport function readVoltage(step) {\n    later(step, function () {\n        return {voltage: Number(step.params.voltage)-0.001,\n                current: 0.100, source: 'SYNTHETIC'};\n    });\n}\nexport function waveform(step) {\n    later(step, function () {\n        return {vpp: Number(step.params.amplitude)*1.02,\n                frequency: Number(step.params.frequency)+0.2,\n                source: 'SYNTHETIC'};\n    });\n}\nexport function diagnostic(step) {\n    later(step, function () { return Number(step.params.trial); });\n}\nexport function cleanup(step) { later(step, function () { return true; }); }\n\n// IF/ELSE children are ordinary test procedures. The Test Executive chooses\n// which to call; neither one needs to implement any branch logic.\nexport function branchHigh(step) {\n    print('THEN branch: ' + step.name);\n    return true;\n}\nexport function branchLow(step) {\n    print('ELSE branch: ' + step.name);\n    return true;\n}\n"
    }
  ],
  "testDefinition": {
    "schemaVersion": 1,
    "id": "conditional-flow-lab-1514",
    "title": "Conditional Flow and Variable Catalog Lab",
    "config": {
      "sequenceId": "stationSequence",
      "tableId": "stationTable",
      "logId": "stationLog",
      "summaryId": "stationSummary",
      "stopOnFailure": true,
      "totalTimeoutMs": 20000
    },
    "steps": [
      {
        "id": "prepare",
        "name": "SETUP — Prepare test",
        "type": "action",
        "mode": "callback",
        "group": "setup",
        "handler": "setup"
      },
      {
        "id": "check_temperature",
        "name": "IF temperature is above 45 C (run variable)",
        "group": "main",
        "condition": {
          "source": "variable",
          "key": "temperature",
          "operator": ">",
          "value": 45
        },
        "steps": [
          {
            "id": "temperature_then",
            "name": "THEN — record high-temperature branch",
            "type": "action",
            "mode": "once",
            "handler": "branchHigh"
          },
          {
            "id": "temperature_else",
            "name": "ELSE — cooler path",
            "otherwise": true,
            "steps": [
              {
                "id": "temperature_else_action",
                "name": "ELSE — record lower-temperature branch",
                "type": "action",
                "mode": "once",
                "handler": "branchLow"
              }
            ]
          }
        ]
      },
      {
        "id": "voltage_sweep",
        "name": "Three-point voltage sweep",
        "group": "main",
        "loop": {
          "parameter": "voltage",
          "start": 5,
          "stop": 4.5,
          "increment": -0.25
        },
        "steps": [
          {
            "id": "voltage_step",
            "name": "Voltage ${voltage} V · 2 checks",
            "type": "numeric",
            "mode": "callback",
            "handler": "readVoltage",
            "measurements": {
              "voltage": {
                "name": "Readback ${voltage} V",
                "low": {
                  "param": "voltage",
                  "offset": -0.05
                },
                "high": {
                  "param": "voltage",
                  "offset": 0.05
                },
                "unit": "V"
              },
              "current": {
                "name": "Load current ${voltage} V",
                "low": 0.08,
                "high": 0.12,
                "unit": "A"
              }
            },
            "timeoutMs": 2000
          },
          {
            "id": "evaluate_voltage",
            "name": "IF readback voltage > 4.75 V",
            "condition": {
              "source": "measurement",
              "step": "voltage_step",
              "path": "voltage",
              "operator": ">",
              "value": 4.75
            },
            "steps": [
              {
                "id": "voltage_high",
                "name": "THEN — diagnostic for ${voltage} V",
                "type": "action",
                "mode": "once",
                "handler": "branchHigh"
              },
              {
                "id": "voltage_else",
                "name": "ELSE",
                "otherwise": true,
                "steps": [
                  {
                    "id": "voltage_normal",
                    "name": "ELSE — continue at ${voltage} V",
                    "type": "action",
                    "mode": "once",
                    "handler": "branchLow"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "wave_sweep",
        "name": "Waveform 1/2 Vpp at 1/5 kHz",
        "group": "main",
        "loop": {
          "axes": [
            {
              "parameter": "amplitude",
              "values": [
                1,
                2
              ]
            },
            {
              "parameter": "frequency",
              "values": [
                1000,
                5000
              ]
            }
          ]
        },
        "steps": [
          {
            "id": "wave_step",
            "name": "Wave ${amplitude} Vpp at ${frequency} Hz",
            "type": "numeric",
            "mode": "callback",
            "handler": "waveform",
            "parameters": {
              "shape": "sine"
            },
            "measurements": {
              "vpp": {
                "name": "Amplitude ${amplitude} Vpp",
                "low": {
                  "param": "amplitude",
                  "factor": 0.95
                },
                "high": {
                  "param": "amplitude",
                  "factor": 1.05
                },
                "unit": "Vpp"
              },
              "frequency": {
                "name": "Frequency ${frequency} Hz",
                "low": {
                  "param": "frequency",
                  "factor": 0.97
                },
                "high": {
                  "param": "frequency",
                  "factor": 1.03
                },
                "unit": "Hz"
              }
            },
            "timeoutMs": 2000
          }
        ]
      },
      {
        "id": "repeat_three",
        "name": "Repeat diagnostic three times",
        "group": "main",
        "repeat": {
          "count": 3,
          "index": "trial"
        },
        "steps": [
          {
            "id": "repeat_test",
            "name": "Diagnostic pass ${trial}",
            "type": "numeric",
            "mode": "callback",
            "handler": "diagnostic",
            "limits": {
              "low": 0,
              "high": 2
            },
            "timeoutMs": 2000
          }
        ]
      },
      {
        "id": "release",
        "name": "CLEANUP — Release station",
        "group": "cleanup",
        "type": "action",
        "mode": "callback",
        "handler": "cleanup"
      }
    ],
    "variables": [
      {
        "name": "temperature",
        "type": "number",
        "initial": 25,
        "description": "Updated by Setup to simulate a temperature reading"
      },
      {
        "name": "stationReady",
        "type": "boolean",
        "initial": false,
        "description": "Updated by Setup after safety checks"
      },
      {
        "name": "boardRevision",
        "type": "string",
        "initial": "A",
        "description": "Example UUT revision; available to IF conditions"
      }
    ]
  },
  "testLibrary": "ConditionalFlowSteps.mjs",
  "runInformation": {},
  "reportStorage": {
    "autoSave": false,
    "directory": ""
  },
  "name": "WFScript Conditional Flow Lab RC1.5.14"
}
