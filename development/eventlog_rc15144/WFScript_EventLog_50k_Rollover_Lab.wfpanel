      "min": 0,
      "properties": {
        "autoScroll": true,
        "maxEntries": 50000,
        "showSource": true,
        "showTimestamp": true
      },
      "text": "50,000-entry rolling Event Log",
      "type": "event_log",
      "value": 0,
