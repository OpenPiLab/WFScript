      "height": 54,
      "text": "1. START, scroll while logging, optionally try INFO/PASS filters.  2. Run 3–5 minutes (50k fills near 2m 17s).  3. STOP.  4. Export CSV; send it for analysis.",
      "value": 0,
      "min": 0,
      "max": 100,
      "events": {},
