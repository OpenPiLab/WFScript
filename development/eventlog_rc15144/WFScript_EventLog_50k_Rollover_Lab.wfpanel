  ],
  "description": "RC1.5.14.4 capacity/scroll regression for Event Log; 10/20/30 ms producer-timestamped timer pairs; 50,000 retained entries",
  "format": "WFScriptPanel",
  "libraries": [],
  "script": "// WFScript RC1.5.14.4 — Event Log rolling-capacity and GUI-latency lab.\n// Derived from the user's LargeLogTest.wfpanel. No instruments or outputs.\n// Exactly two log entries per callback: INFO then PASS.\n// The INFO message contains callbackEpochMs (captured on the JS worker\n// thread), whereas the exported Timestamp column comes from EventLogWidget\n// on the GUI thread. Compare the two to locate backlogs without guessing.\n// JavaScript Date.now() is millisecond resolution, not a real-time clock.\n\nvar id=0, id1=0, id2=0, statusTimer=0;\nvar active=false, runNumber=0;\nvar counts={id:0,id1:0,id2:0};\nvar startMs=0;\n\nfunction logPair(name) {\n    var callbackEpochMs=Date.now();\n    counts[name]++;\n    var seq=counts[name];\n    var tag='run='+runNumber+' | seq='+seq;\n    ui.set('stationLog',{append:{level:'INFO',source:name,\n        message:name+' Starting check | '+tag+' | callbackEpochMs='+callbackEpochMs}});\n    ui.set('stationLog',{append:{level:'PASS',source:name,\n        message:name+' Voltage within tolerance | '+tag}});\n}\n\nfunction refreshStatus() {\n    if(!active)return;\n    var seconds=Math.round((Date.now()-startMs)/1000);\n    ui.set('timerStatus','RUN '+runNumber+' | '+seconds+' s | '+\n        'id(10): '+counts.id+'   id1(20): '+counts.id1+\n        '   id2(30): '+counts.id2+'   | Scroll and try filters');\n}\nfunction stopTimers() {\n    if(id)clearInterval(id);\n    if(id1)clearInterval(id1);\n    if(id2)clearInterval(id2);\n    if(statusTimer)clearInterval(statusTimer);\n    id=0;id1=0;id2=0;statusTimer=0;\n    active=false;\n    ui.set('timerStatus','STOPPED | Run '+runNumber+' | '+\n        'id: '+counts.id+'   id1: '+counts.id1+'   id2: '+counts.id2+\n        ' | Export CSV from Event Log');\n}\nfunction onButton1Clicked() {\n    if(active)return; // prevent double-registration of timers\n    runNumber++;\n    counts={id:0,id1:0,id2:0};\n    startMs=Date.now();\n    active=true;\n    id=setInterval(function(){logPair('id');},10);\n    id1=setInterval(function(){logPair('id1');},20);\n    id2=setInterval(function(){logPair('id2');},30);\n    statusTimer=setInterval(refreshStatus,1000);\n    refreshStatus();\n}\nfunction onButton2Clicked() {stopTimers();}\nfunction onButton3Clicked() {ui.set('stationLog',{clear:true});}\nfunction onShutdown() {\n    if(id)clearInterval(id);\n    if(id1)clearInterval(id1);\n    if(id2)clearInterval(id2);\n    if(statusTimer)clearInterval(statusTimer);\n    active=false;id=0;id1=0;id2=0;statusTimer=0;\n}\n",
  "scriptName": "WFScript_EventLog_50k_Rollover_Lab.js",
  "version": 1
}
