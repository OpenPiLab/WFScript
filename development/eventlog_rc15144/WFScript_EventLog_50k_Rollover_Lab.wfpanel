    {
      "id": "labTitle",
      "type": "label",
      "x": 32,
      "y": 18,
      "width": 1180,
      "height": 48,
      "text": "EVENT LOG CAPACITY TEST  |  RC1.5.14.4",
      "value": 0,
      "min": 0,
      "max": 100,
      "events": {},
      "properties": {
        "textFormat": "Plain Text",
        "wordWrap": false,
        "borderVisible": false
      }
